# Copy this file to preprod.env and fill it with PRE-PROD-only values.
# Never reuse DEV credentials or commit preprod.env.

MDIP_METASTORE_HOST=192.168.11.91
MDIP_METASTORE_PORT=5432
MDIP_METASTORE_DATABASE=Futran
MDIP_METASTORE_USERNAME=REPLACE_WITH_PREPROD_SERVICE_USER
MDIP_METASTORE_PASSWORD=
MDIP_METASTORE_CONNECT_TIMEOUT=10
# The referenced DEV metastore is documented as not supporting SSL.
# Enable TLS on the shared metastore before PRE-PROD sign-off.
MDIP_METASTORE_SSLMODE=disable

MDIP_DB_SECRET_PREPROD_SOURCE=
MDIP_DB_SECRET_PREPROD_TARGET=